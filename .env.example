# JiraJitsu Environment Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to version control!

# JitBit API Credentials
JITBIT_API_URL=https://your-company.jitbit.com/helpdesk/api
# Authentication method: 'basic' or 'token'
JITBIT_AUTH_METHOD=basic
# For basic auth:
JITBIT_USER=your_jitbit_username
JITBIT_PWD=your_jitbit_password
# For token auth (leave user/pwd empty if using token):
JITBIT_TOKEN=

# JIRA API Credentials
JIRA_API_URL=https://your-jira-instance.com/rest/api/2
# Authentication method: 'basic' or 'token'
JIRA_AUTH_METHOD=basic
# For basic auth:
JIRA_USER=your_jira_username
JIRA_PWD=your_jira_password
# For token auth:
# - JIRA Cloud: Set JIRA_USER to your email and JIRA_TOKEN to your API token
# - JIRA Server/DC PAT: Leave JIRA_USER empty and set JIRA_TOKEN to your Personal Access Token
JIRA_TOKEN=
